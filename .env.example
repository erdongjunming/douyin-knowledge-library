DKL_STORAGE_ROOT=D:\DouyinKnowledgeLibrary
DKL_JOB_CONCURRENCY=2
DKL_TRANSCRIPTION_CONCURRENCY=1
DKL_EMBEDDED_WORKERS=false
DKL_WORKER_POLL_SECONDS=1
DKL_JOB_HEARTBEAT_SECONDS=10
DKL_JOB_STALE_SECONDS=120
DKL_GPU_RESOURCE_NAME=gpu:0
DKL_GPU_LEASE_TTL_SECONDS=120
DKL_GPU_LEASE_POLL_SECONDS=0.5
DKL_TRANSCRIPTION_MODEL=Qwen/Qwen3-ASR-0.6B
DKL_TRANSCRIPTION_LANGUAGE=Chinese
DKL_QWEN_CHUNK_SECONDS=60
# Subtitle-first transcription. A usable local subtitle skips ASR entirely;
# set false only when the subtitle source is intentionally unavailable.
DKL_TRANSCRIPTION_SUBTITLE_ENABLED=true
# Optional qwen3:4b transcript cleaning. Raw subtitle/ASR evidence remains
# immutable and is used when cleaning is disabled or fails validation.
DKL_TRANSCRIPTION_CLEANING_ENABLED=false
DKL_TRANSCRIPTION_CLEANER_MODEL=qwen3:4b
DKL_TRANSCRIPTION_CLEANER_TIMEOUT_SECONDS=600
DKL_TRANSCRIPTION_CLEANER_BATCH_CHARACTER_LIMIT=12000
DKL_TRANSCRIPTION_CLEANER_DRIFT_RATIO=0.5
DKL_TRANSCRIPTION_CLEANER_PROMPT_VERSION=v1
DKL_TRANSCRIPTION_CLEANER_KEEP_ALIVE=10m
DKL_TRANSCRIPTION_CLEANER_THINKING=false
DKL_AUDIT_INLINE_MAX_BYTES=65536
DKL_DATABASE_BACKUP_INTERVAL_HOURS=24
DKL_DATABASE_BACKUP_RETENTION=7
DKL_NOTE_PROVIDER_POLICY=auto
DKL_NOTE_OLLAMA_URL=http://127.0.0.1:11434
DKL_NOTE_OLLAMA_MODEL=qwen3:4b
DKL_NOTE_OLLAMA_AUTOSTART=true
DKL_NOTE_CONTEXT_TOKENS=32768
DKL_NOTE_REQUEST_TIMEOUT_SECONDS=600
# Optional OpenAI-compatible provider. Leave all three values empty to keep
# generation local-only; never commit a real key to this file.
DKL_NOTE_EXTERNAL_BASE_URL=
DKL_NOTE_EXTERNAL_MODEL=
DKL_NOTE_EXTERNAL_API_KEY=
# Optional rates used only to estimate external cost when the provider does
# not report one (currency is provider-defined).
DKL_NOTE_EXTERNAL_INPUT_COST_PER_MILLION=
DKL_NOTE_EXTERNAL_OUTPUT_COST_PER_MILLION=
